// NS7MIDIDriver.iig
// Publishes the NS7 to CoreMIDI: one device, one entity "MIDI" with one
// source and one destination, named the way Numark's original driver named
// them. NumarkNS7Device creates it in its own process with IOService::Create
// (from the NS7MIDIDriverProperties dictionary in its personality) and is its
// provider; a separate matching personality ran in another process.
// NumarkNS7Device owns all USB I/O and calls the two LOCALONLY methods below
// on its USB queue: DeliverMidiIn from the EP 0x83 completion, and
// NextMidiOutPacket to fill each EP 0x04 transfer. The CoreMIDI destination
// feeds NextMidiOutPacket through a lock-free FIFO. See
// docs/superpowers/specs/2026-09-26-coremidi-service-design.md.

#ifndef NS7MIDIDriver_h
#define NS7MIDIDriver_h

#include <DriverKit/IOService.iig>
#include <MIDIDriverKit/IOUserMIDIDriver.iig>

class NS7MIDIDriver : public IOUserMIDIDriver
{
public:
    virtual bool init() override;
    virtual void free() override;

    virtual kern_return_t Start(IOService * provider) override;
    virtual kern_return_t Stop(IOService * provider) override;

    virtual kern_return_t StartIO(OSArray * deviceList) override LOCALONLY;
    virtual kern_return_t StopIO() override LOCALONLY;

    // Complete UMP messages from the NS7, sent to the CoreMIDI source.
    void DeliverMidiIn(const uint32_t * words, uint32_t count) LOCALONLY;

    // Fills one 42-byte EP 0x04 packet from pending CoreMIDI output.
    // Returns the number of MIDI bytes packed; 0 means nothing to send.
    uint32_t NextMidiOutPacket(uint8_t * packet) LOCALONLY;

    // Returns the number of CoreMIDI output messages dropped because the FIFO
    // was full since the last call, and resets it.
    uint32_t TakeMidiOutDropped() LOCALONLY;

    // Diagnostics, cumulative since Start and wrapping at 2^32: destination
    // IO block calls, UMP words received, raw MIDI bytes queued into the
    // FIFO, and the first UMP word of the latest call. Null pointers are skipped.
    void GetMidiOutBlockStats(uint32_t * calls, uint32_t * words, uint32_t * bytesQueued,
                              uint32_t * lastWord) LOCALONLY;
};

#endif /* NS7MIDIDriver_h */
