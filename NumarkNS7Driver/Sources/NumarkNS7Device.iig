// NumarkNS7Device.iig
// USB root service for the Numark NS7 (VID 0x15E4, PID 0x0071).
//
// The NS7 is NOT a USB Audio/MIDI class device. It exposes two vendor-specific
// (class 0xFF) interfaces using Ploytec's proprietary protocol; alternate
// setting 1 of each carries the endpoints (read from the hardware):
//
//   IF0 alt1:  EP 0x02 iso  OUT  156 B / microframe   playback
//              EP 0x83 bulk IN   512 B                MIDI in
//              EP 0x04 bulk OUT  512 B                MIDI out
//   IF1 alt1:  EP 0x81 iso  IN    64 B / 1 ms         rate feedback
//              EP 0x86 bulk IN   512 B                capture
//
// This service claims the device, selects those alternate settings, runs the
// Ploytec startup handshake and keeps the audio pipes streaming. The device
// only sends MIDI while the audio pipes run (verified on hardware), so they
// stream silence even with no audio client. MIDI input is parsed to UMP.
// Start creates the CoreMIDI service (NS7MIDIDriver) in this process with
// IOService::Create, from the NS7MIDIDriverProperties personality dictionary.
// Endpoint roles and wire formats are documented in docs/PROTOCOL.md.

#ifndef NumarkNS7Device_h
#define NumarkNS7Device_h

#include <Availability.h>
#include <DriverKit/IOService.iig>
#include <DriverKit/IOTimerDispatchSource.iig>
#include <USBDriverKit/IOUSBHostPipe.iig>

class IOUSBHostDevice;
class IOUSBHostInterface;
class NS7MIDIDriver;

class NumarkNS7Device : public IOService
{
public:
    virtual bool init() override;
    virtual void free() override;

    virtual kern_return_t Start(IOService * provider) override;
    virtual kern_return_t Stop(IOService * provider) override;

    // System sleep/wake. Sleep (kIOServicePowerCapabilityOff) parks the
    // streaming chains; wake restarts them on a freshly read bus frame.
    virtual kern_return_t SetPowerState(uint32_t powerFlags) override LOCAL;

    // Accessors for the audio and MIDI services, which run in this process.
    IOUSBHostDevice * GetUSBDevice() LOCALONLY;
    IOUSBHostPipe *   GetPipe(uint8_t endpointAddress) LOCALONLY;

    // Registers the CoreMIDI service (retained) that receives MIDI in and
    // supplies MIDI out; nullptr unregisters it. Safe from any thread.
    void SetMidiClient(NS7MIDIDriver * client) LOCALONLY;

    // Waits until any block running on this service's default queue (where
    // MidiInComplete delivers MIDI in and MIDI out is pumped) has finished.
    // Call after SetMidiClient(nullptr) to be sure no call into the client is
    // still in flight. Best-effort: if the default queue can't be obtained it
    // logs and returns without syncing. Must not be called from this
    // service's default queue.
    void SyncUsbQueue() LOCALONLY;

protected:
    // Streaming completions. Each in-flight request has its own OSAction whose
    // reference holds the request's slot index.
    virtual void PlaybackComplete(OSAction * action, IOReturn status)
        TYPE(IOUSBHostPipe::CompleteAsyncIsochIO);
    virtual void FeedbackComplete(OSAction * action, IOReturn status)
        TYPE(IOUSBHostPipe::CompleteAsyncIsochIO);
    virtual void CaptureComplete(OSAction * action, IOReturn status,
                                 uint32_t actualByteCount, uint64_t completionTimestamp)
        TYPE(IOUSBHostPipe::CompleteAsyncIO);
    virtual void MidiInComplete(OSAction * action, IOReturn status,
                                uint32_t actualByteCount, uint64_t completionTimestamp)
        TYPE(IOUSBHostPipe::CompleteAsyncIO);
    virtual void MidiOutComplete(OSAction * action, IOReturn status,
                                 uint32_t actualByteCount, uint64_t completionTimestamp)
        TYPE(IOUSBHostPipe::CompleteAsyncIO);

    // Streaming watchdog (every ~100 ms on the default queue): restarts any
    // request slot that is idle, and aborts the iso pipes if no iso request
    // has completed for ~1 s so stranded requests come back and are re-armed.
    virtual void WatchdogFired(OSAction * action, uint64_t time)
        TYPE(IOTimerDispatchSource::TimerOccurred);
};

#endif /* NumarkNS7Device_h */
