<?xml version="1.0" encoding="utf-8"?>
<!--
  Numark NS7 (DriverKit) - Mixxx 2.5 controller mapping

  For the original Numark NS7 driven by the NumarkNS7 macOS DriverKit driver
  (CoreMIDI device "Numark USB Audio Device", port "MIDI").

  Derived from the "Numark NS7" mapping shipped with Mixxx
  (Copyright (C) 2010 Anders Gunnarsson, GPLv2 or later).
  SPDX-License-Identifier: GPL-2.0-or-later
-->
<MixxxMIDIPreset schemaVersion="1" mixxxVersion="2.5.0+">
    <info>
        <name>Numark NS7 (DriverKit)</name>
        <author>Andrew Abner (based on the 2010 mapping by Anders Gunnarsson)</author>
        <description>Numark NS7 mapping for the macOS DriverKit driver (CoreMIDI device "Numark USB Audio Device"). Derived from Anders Gunnarsson's 2010 Numark NS7 mapping (GPLv2+). Adds engine scratching on the platters, LED feedback and fixes. Platter touch and several controls are still to be identified.</description>
        <forums>https://mixxx.discourse.group/c/controller-mappings/10</forums>
        <wiki>https://github.com/mixxxdj/mixxx/wiki/Numark-NS7</wiki>
        <manual>numark_ns7</manual>
        <devices>
            <product protocol="midi" vendor_id="0x15e4" product_id="0x0071"/>
        </devices>
    </info>
    <controller id="Numark USB Audio Device MIDI">
        <scriptfiles>
            <file filename="Numark-NS7-DriverKit-scripts.js" functionprefix="NumarkNS7DK"/>
        </scriptfiles>
        <controls>
        <!-- ============================ Deck A ============================ -->
        <!-- Transport -->
        <control>
            <group>[Channel1]</group>
            <key>play</key>
            <status>0x90</status>
            <midino>0x11</midino>
            <options>
                <Button/>
            </options>
        </control>
        <control>
            <group>[Channel1]</group>
            <key>cue_default</key>
            <status>0x90</status>
            <midino>0x10</midino>
            <options>
                <Button/>
            </options>
        </control>
        <!-- Sync -->
        <control>
            <group>[Channel1]</group>
            <key>beatsync</key>
            <status>0x90</status>
            <midino>0x0F</midino>
            <options>
                <Button/>
            </options>
        </control>
        <control>
            <group>[Channel1]</group>
            <key>keylock</key>
            <status>0x90</status>
            <midino>0x1B</midino>
            <options>
                <Button/>
            </options>
        </control>
        <!-- Search -->
        <control>
            <group>[Channel1]</group>
            <key>back</key>
            <status>0x90</status>
            <midino>0x1F</midino>
            <options>
                <Button/>
            </options>
        </control>
        <control>
            <group>[Channel1]</group>
            <key>fwd</key>
            <status>0x90</status>
            <midino>0x20</midino>
            <options>
                <Button/>
            </options>
        </control>
        <!-- Hotcues 1-5 -->
        <control>
            <group>[Channel1]</group>
            <key>hotcue_1_activate</key>
            <status>0x90</status>
            <midino>0x13</midino>
            <options>
                <Button/>
            </options>
        </control>
        <control>
            <group>[Channel1]</group>
            <key>hotcue_2_activate</key>
            <status>0x90</status>
            <midino>0x14</midino>
            <options>
                <Button/>
            </options>
        </control>
        <control>
            <group>[Channel1]</group>
            <key>hotcue_3_activate</key>
            <status>0x90</status>
            <midino>0x15</midino>
            <options>
                <Button/>
            </options>
        </control>
        <control>
            <group>[Channel1]</group>
            <key>hotcue_4_activate</key>
            <status>0x90</status>
            <midino>0x16</midino>
            <options>
                <Button/>
            </options>
        </control>
        <control>
            <group>[Channel1]</group>
            <key>hotcue_5_activate</key>
            <status>0x90</status>
            <midino>0x17</midino>
            <options>
                <Button/>
            </options>
        </control>
        <!-- Loops -->
        <control>
            <group>[Channel1]</group>
            <key>loop_in</key>
            <status>0x90</status>
            <midino>0x28</midino>
            <options>
                <Button/>
            </options>
        </control>
        <control>
            <group>[Channel1]</group>
            <key>loop_out</key>
            <status>0x90</status>
            <midino>0x29</midino>
            <options>
                <Button/>
            </options>
        </control>
        <!-- Deck A reloop is 0x90 0x31 in the 2010 mapping, but that is also
             Deck B Cue (0x90 0x31), so it is disabled until the guided
             capture tells us which one is right.
        <control>
            <group>[Channel1]</group>
            <key>reloop_toggle</key>
            <status>0x90</status>
            <midino>0x31</midino>
            <options>
                <Button/>
            </options>
        </control>
        -->
        <!-- Load -->
        <control>
            <group>[Channel1]</group>
            <key>LoadSelectedTrack</key>
            <status>0x90</status>
            <midino>0x0C</midino>
            <options>
                <Button/>
            </options>
        </control>
        <!-- Pitch fader (7-bit; may be 14-bit, to be verified) -->
        <control>
            <group>[Channel1]</group>
            <key>rate</key>
            <status>0xB0</status>
            <midino>0x04</midino>
        </control>
        <!-- Pitch bend buttons -->
        <control>
            <group>[Channel1]</group>
            <key>rate_temp_down</key>
            <status>0x90</status>
            <midino>0x18</midino>
            <options>
                <Button/>
            </options>
        </control>
        <control>
            <group>[Channel1]</group>
            <key>rate_temp_up</key>
            <status>0x90</status>
            <midino>0x19</midino>
            <options>
                <Button/>
            </options>
        </control>
        <!-- Pitch range (cycles 8/10/30/100 %) -->
        <control>
            <group>[Channel1]</group>
            <key>NumarkNS7DK.rateRange</key>
            <status>0x90</status>
            <midino>0x1A</midino>
            <options>
                <Script-Binding/>
            </options>
        </control>
        <!-- Scratch mode toggle -->
        <control>
            <group>[Channel1]</group>
            <key>NumarkNS7DK.scratchButton</key>
            <status>0x90</status>
            <midino>0x21</midino>
            <options>
                <Script-Binding/>
            </options>
        </control>
        <!-- Platter (7-bit wrap-around encoder) -->
        <control>
            <group>[Channel1]</group>
            <key>NumarkNS7DK.jog</key>
            <status>0xB0</status>
            <midino>0x00</midino>
            <options>
                <Script-Binding/>
            </options>
        </control>
        <!-- Strip search -->
        <control>
            <group>[Channel1]</group>
            <key>playposition</key>
            <status>0xB0</status>
            <midino>0x45</midino>
        </control>

        <!-- ============================ Deck B ============================ -->
        <!-- Transport -->
        <control>
            <group>[Channel2]</group>
            <key>play</key>
            <status>0x90</status>
            <midino>0x32</midino>
            <options>
                <Button/>
            </options>
        </control>
        <control>
            <group>[Channel2]</group>
            <key>cue_default</key>
            <status>0x90</status>
            <midino>0x31</midino>
            <options>
                <Button/>
            </options>
        </control>
        <!-- Sync -->
        <control>
            <group>[Channel2]</group>
            <key>beatsync</key>
            <status>0x90</status>
            <midino>0x30</midino>
            <options>
                <Button/>
            </options>
        </control>
        <control>
            <group>[Channel2]</group>
            <key>keylock</key>
            <status>0x90</status>
            <midino>0x3C</midino>
            <options>
                <Button/>
            </options>
        </control>
        <!-- Search -->
        <control>
            <group>[Channel2]</group>
            <key>back</key>
            <status>0x90</status>
            <midino>0x40</midino>
            <options>
                <Button/>
            </options>
        </control>
        <control>
            <group>[Channel2]</group>
            <key>fwd</key>
            <status>0x90</status>
            <midino>0x41</midino>
            <options>
                <Button/>
            </options>
        </control>
        <!-- Hotcues 1-5 -->
        <control>
            <group>[Channel2]</group>
            <key>hotcue_1_activate</key>
            <status>0x90</status>
            <midino>0x34</midino>
            <options>
                <Button/>
            </options>
        </control>
        <control>
            <group>[Channel2]</group>
            <key>hotcue_2_activate</key>
            <status>0x90</status>
            <midino>0x35</midino>
            <options>
                <Button/>
            </options>
        </control>
        <control>
            <group>[Channel2]</group>
            <key>hotcue_3_activate</key>
            <status>0x90</status>
            <midino>0x36</midino>
            <options>
                <Button/>
            </options>
        </control>
        <control>
            <group>[Channel2]</group>
            <key>hotcue_4_activate</key>
            <status>0x90</status>
            <midino>0x37</midino>
            <options>
                <Button/>
            </options>
        </control>
        <control>
            <group>[Channel2]</group>
            <key>hotcue_5_activate</key>
            <status>0x90</status>
            <midino>0x38</midino>
            <options>
                <Button/>
            </options>
        </control>
        <!-- Loops -->
        <control>
            <group>[Channel2]</group>
            <key>loop_in</key>
            <status>0x90</status>
            <midino>0x49</midino>
            <options>
                <Button/>
            </options>
        </control>
        <control>
            <group>[Channel2]</group>
            <key>loop_out</key>
            <status>0x90</status>
            <midino>0x50</midino>
            <options>
                <Button/>
            </options>
        </control>
        <control>
            <group>[Channel2]</group>
            <key>reloop_toggle</key>
            <status>0x90</status>
            <midino>0x52</midino>
            <options>
                <Button/>
            </options>
        </control>
        <!-- Load -->
        <control>
            <group>[Channel2]</group>
            <key>LoadSelectedTrack</key>
            <status>0x90</status>
            <midino>0x0E</midino>
            <options>
                <Button/>
            </options>
        </control>
        <!-- Pitch fader (7-bit; may be 14-bit, to be verified) -->
        <control>
            <group>[Channel2]</group>
            <key>rate</key>
            <status>0xB0</status>
            <midino>0x05</midino>
        </control>
        <!-- Pitch bend buttons -->
        <control>
            <group>[Channel2]</group>
            <key>rate_temp_down</key>
            <status>0x90</status>
            <midino>0x39</midino>
            <options>
                <Button/>
            </options>
        </control>
        <control>
            <group>[Channel2]</group>
            <key>rate_temp_up</key>
            <status>0x90</status>
            <midino>0x3A</midino>
            <options>
                <Button/>
            </options>
        </control>
        <!-- Pitch range (cycles 8/10/30/100 %) -->
        <control>
            <group>[Channel2]</group>
            <key>NumarkNS7DK.rateRange</key>
            <status>0x90</status>
            <midino>0x3B</midino>
            <options>
                <Script-Binding/>
            </options>
        </control>
        <!-- Scratch mode toggle -->
        <control>
            <group>[Channel2]</group>
            <key>NumarkNS7DK.scratchButton</key>
            <status>0x90</status>
            <midino>0x42</midino>
            <options>
                <Script-Binding/>
            </options>
        </control>
        <!-- Platter (7-bit wrap-around encoder) -->
        <control>
            <group>[Channel2]</group>
            <key>NumarkNS7DK.jog</key>
            <status>0xB0</status>
            <midino>0x02</midino>
            <options>
                <Script-Binding/>
            </options>
        </control>
        <!-- Strip search -->
        <control>
            <group>[Channel2]</group>
            <key>playposition</key>
            <status>0xB0</status>
            <midino>0x4D</midino>
        </control>

        <!-- ============================ Mixer ============================= -->
        <!-- Crossfader -->
        <control>
            <group>[Master]</group>
            <key>crossfader</key>
            <status>0xB0</status>
            <midino>0x07</midino>
        </control>
        <!-- Headphone cue/main mix -->
        <control>
            <group>[Master]</group>
            <key>headMix</key>
            <status>0xB0</status>
            <midino>0x12</midino>
        </control>
        <!-- Headphone volume -->
        <control>
            <group>[Master]</group>
            <key>headGain</key>
            <status>0xB0</status>
            <midino>0x42</midino>
        </control>
        <!-- Main volume -->
        <control>
            <group>[Master]</group>
            <key>gain</key>
            <status>0xB0</status>
            <midino>0x40</midino>
        </control>
        <!-- Channel1: gain, EQ, volume -->
        <control>
            <group>[Channel1]</group>
            <key>pregain</key>
            <status>0xB0</status>
            <midino>0x0C</midino>
        </control>
        <!-- High -->
        <control>
            <group>[EqualizerRack1_[Channel1]_Effect1]</group>
            <key>parameter3</key>
            <status>0xB0</status>
            <midino>0x0B</midino>
        </control>
        <!-- Mid -->
        <control>
            <group>[EqualizerRack1_[Channel1]_Effect1]</group>
            <key>parameter2</key>
            <status>0xB0</status>
            <midino>0x0A</midino>
        </control>
        <!-- Low -->
        <control>
            <group>[EqualizerRack1_[Channel1]_Effect1]</group>
            <key>parameter1</key>
            <status>0xB0</status>
            <midino>0x09</midino>
        </control>
        <!-- Channel fader -->
        <control>
            <group>[Channel1]</group>
            <key>volume</key>
            <status>0xB0</status>
            <midino>0x08</midino>
        </control>
        <!-- Channel2: gain, EQ, volume -->
        <control>
            <group>[Channel2]</group>
            <key>pregain</key>
            <status>0xB0</status>
            <midino>0x11</midino>
        </control>
        <!-- High -->
        <control>
            <group>[EqualizerRack1_[Channel2]_Effect1]</group>
            <key>parameter3</key>
            <status>0xB0</status>
            <midino>0x10</midino>
        </control>
        <!-- Mid -->
        <control>
            <group>[EqualizerRack1_[Channel2]_Effect1]</group>
            <key>parameter2</key>
            <status>0xB0</status>
            <midino>0x0F</midino>
        </control>
        <!-- Low -->
        <control>
            <group>[EqualizerRack1_[Channel2]_Effect1]</group>
            <key>parameter1</key>
            <status>0xB0</status>
            <midino>0x0E</midino>
        </control>
        <!-- Channel fader -->
        <control>
            <group>[Channel2]</group>
            <key>volume</key>
            <status>0xB0</status>
            <midino>0x0D</midino>
        </control>
        </controls>
        <!-- All LED feedback (play, cue, PFL, end-of-track, optional VU meter)
             is sent from the script via engine.makeConnection so that it can
             be switched off cleanly in init/shutdown. -->
        <outputs/>
    </controller>
    <!--
    ==========================================================================
    TODO - to be identified in the upcoming guided capture
    ==========================================================================
      0xB0 0x24 xx     unknown (continuous value)
      0xB0 0x30 0x62   unknown
      0xB0 0x6E 0x00   unknown
      0xE0 lsb msb     pitch-bend stream while the deck A platter spins
      0xE2 lsb msb     pitch-bend stream while the deck B platter spins
                       (probably a platter timing companion to the jog CC)
      Platter touch    unknown -> bind NumarkNS7DK.platterTouch (Script-Binding)
      Scratch LED      unknown CC
      PFL buttons      input unknown (the LEDs are mapped in the script)
      0x90 0x31        2010 mapping: Deck A reloop AND Deck B cue (conflict)
      0x90 0x50        Deck B loop out per 2010 mapping; 0x4A would fit the
                       deck A/B offset of 0x21 - verify
    -->
</MixxxMIDIPreset>
